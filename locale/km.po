msgid "Mass Edit"
msgstr "កែសម្រួលជាក្រុម"

msgctxt "view:mass.editing.wizard.start:"
msgid "Select fields to update."
msgstr "ជ្រើសរើសវាលដើម្បីធ្វើបច្ចុប្បន្នភាព។"

msgctxt "view:mass.editing:"
msgid ""
"Mass editing is a dangerous operation and in some cases may not work or not "
"work as expected. Make responsible use of it with previous relevant tests."
msgstr ""
"ការកែសម្រួលជាក្រុមជាប្រតិបត្តិការដែលមានហានិភ័យ ហើយអាចមិនដំណើរការ "
"ឬដំណើរការខុសពីការរំពឹងក្នុងករណីខ្លះ។ សូមប្រើដោយប្រុងប្រយ័ត្ន "
"និងធ្វើតេស្តពាក់ព័ន្ធជាមុន។"

msgctxt "wizard_button:mass.editing.wizard,start,end:"
msgid "Cancel"
msgstr "បោះបង់"

msgctxt "wizard_button:mass.editing.wizard,start,update:"
